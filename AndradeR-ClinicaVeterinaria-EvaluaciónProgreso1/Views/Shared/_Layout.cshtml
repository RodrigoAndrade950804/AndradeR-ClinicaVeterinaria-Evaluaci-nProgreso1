<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AndradeR_ClinicaVeterinaria_EvaluaciónProgreso1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Tamaño.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AndradeR_ClinicaVeterinaria_EvaluaciónProgreso1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AndradeR_ClinicaVeterinaria_EvaluaciónProgreso1</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="DueñoMascota" asp-action="Index">Dueños de las mascotas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Mascota" asp-action="Index">Lista de mascotas</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <!-- Campo de texto y botón para mostrar el mensaje -->
        <div class="text-center mt-4">
            <input type="text" id="mensajeInput" class="form-control mb-3" placeholder="Escribe algo aquí..." />
            <button id="mensajeButton" class="btn btn-primary">Mostrar Mensaje</button>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AndradeR_ClinicaVeterinaria_EvaluaciónProgreso1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Script para mostrar el mensaje al hacer clic en el botón
        document.getElementById('mensajeButton').addEventListener('click', function () {
            const inputValue = document.getElementById('mensajeInput').value;
            alert(`Mi nombre es Rodrigo Andrade, mi curso es el 107, mi hobbie es nadar, y el valor del campo de texto es: ${inputValue}`);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


